msgstr "Chọn chế độ tự động"

msgid "Select direct mode"
msgstr "Chọn chế độ trực tiếp"

msgid "Select safe preedit mode"
msgstr "Chọn chế độ preedit an toàn"

msgid "Turn processing off for this context"
msgstr "Tắt xử lý cho ngữ cảnh này"

msgid "Enable the optional emoji picker"
msgstr "Bật bộ chọn emoji tùy chọn"

msgid "Open the emoji picker"
msgstr "Mở bộ chọn emoji"

